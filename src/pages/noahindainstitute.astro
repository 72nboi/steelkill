---
import { url } from '../lib/catalog';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="robots" content="noindex, nofollow, noarchive"/><meta name="theme-color" content="#080b09"/><title>Noah in da Institute | SteelKill</title><link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/></head>
  <body>
    <div class="terminal-shell">
      <header><a href={url()} aria-label="Leave the institute and return to SteelKill">STEELKILL<span> / UNAUTHORISED ACCESS</span></a><span class="record">ARCHIVE 097 · CONTAINMENT WING</span></header>
      <main>
        <div class="titlebar"><div><p class="label">SOME DOORS SHOULD STAY CLOSED.</p><h1>NOAH <span>IN DA</span> INSTITUTE</h1></div><span class="classification">ESCAPE PROTOCOL<br/>SUBJECT: YOU</span></div>
        <div class="game-frame">
          <canvas id="institute" width="640" height="400" tabindex="0" aria-label="First-person escape game. Use WASD to move, arrow keys to turn, and find the exit without Noah touching you." data-sprite={url('images/institute/noah.webp')}></canvas>
          <div class="scanlines" aria-hidden="true"></div>
          <div id="overlay" class="overlay">
            <section class="overlay-card" id="briefing"><p class="label">WELCOME TO YOUR EXTENDED STAY.</p><h2>The exit is real.<br/><em>So is Noah.</em></h2><p>Find the green exit before Noah catches you.<br/>Run loud. Sneak quiet. Don’t let the chair touch you.</p><p class="reward-note">Escape and recover a hidden SteelKill discount code.</p><button class="primary" id="start">Enter the institute</button><p class="small">WASD move · arrows turn · Shift sprint · C sneak<br/>M map · P pause · Touch controls below</p><p id="load-status" role="status">Preparing containment wing…</p></section>
            <section class="overlay-card" id="paused" hidden><p class="label">SURVEILLANCE SUSPENDED</p><h2>Hold your breath.</h2><p>The game is paused. Noah waits.</p><button class="primary" id="resume">Resume</button><button class="secondary restart">Restart run</button></section>
            <section class="overlay-card" id="caught" hidden><p class="label">CONTACT CONFIRMED</p><h2>STAY<br/><em>EXTENDED.</em></h2><p>Noah found you. The exit can wait.</p><button class="primary restart">Try again</button><a class="secondary" href={url()}>Back to SteelKill</a></section>
            <section class="overlay-card" id="escaped" hidden><p class="label">DISCHARGE AUTHORISED</p><h2>You got <em>out.</em></h2><p>Noah is still in there. You don’t have to be.</p><p class="label code-label">YOUR STEELKILL DISCOUNT CODE</p><div id="reward" class="reward"></div><button class="primary" id="copy-code">Copy discount code</button><p id="copy-status" role="status" class="small"></p><div class="victory-links"><a href={url('products/')}>Back to the collection</a><button class="text-button restart">Another run</button></div></section>
          </div>
          <div class="game-hud" aria-hidden="true"><div><span>CONDITION</span><strong id="condition">AWAITING ADMISSION</strong></div><div class="stamina"><span>STAMINA</span><div class="meter"><i id="stamina-fill"></i></div></div><div><span>TIME INSIDE</span><strong id="timer">00:00</strong></div></div>
        </div>
        <div class="toolbar"><button id="pause" disabled>Pause</button><button id="map" aria-pressed="false">Map [M]</button><button id="sound" aria-pressed="false">Sound off</button><button id="motion" aria-pressed="false">Reduce motion</button><span id="game-status" role="status" aria-live="polite">Find the exit. Avoid Noah.</span></div>
        <div class="touch-controls" aria-label="Touch game controls"><div class="move-pad"><button data-control="forward" aria-label="Move forward">W</button><button data-control="left" aria-label="Strafe left">A</button><button data-control="back" aria-label="Move backward">S</button><button data-control="right" aria-label="Strafe right">D</button></div><div class="look-pad"><button data-control="turnLeft" aria-label="Turn left">Turn L</button><button data-control="turnRight" aria-label="Turn right">Turn R</button><button data-control="sprint">Run</button><button data-control="sneak">Sneak</button></div></div>
        <footer><p><kbd>W A S D</kbd> move <kbd>← →</kbd> turn <kbd>SHIFT</kbd> sprint <kbd>C</kbd> sneak <kbd>M</kbd> explored map <kbd>ESC / P</kbd> pause</p><p>Keep quiet. Break line of sight. The chair keeps moving.</p></footer>
      </main>
    </div>
    <script src="../games/institute/main.js"></script>
  </body>
</html>
<style is:global>
  :root{color-scheme:dark;background:#070a08;color:#d4d6bf;font-family:'Courier New',monospace;font-size:16px}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% 0,#202a22 0,transparent 65%);min-height:100dvh}button,a{touch-action:manipulation}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer;border-radius:0}button:disabled{opacity:.35;cursor:wait}button:focus-visible,a:focus-visible,canvas:focus-visible{outline:2px solid #c1d18b;outline-offset:4px}[hidden]{display:none!important}.terminal-shell{max-width:1360px;padding:0 35px;margin:auto}header{display:flex;justify-content:space-between;gap:20px;padding:24px 0;border-bottom:1px solid #344137;font-size:.8rem}header>a{font-weight:bold;letter-spacing:.08em}header>a span,.record{color:#82917c;font-size:.7rem}main{padding:35px 0}.titlebar{display:flex;justify-content:space-between;align-items:end;margin-bottom:22px}.label{font-size:.75rem;letter-spacing:.14em;color:#8c9f7e;line-height:1.6;margin:0 0 12px}h1{font-size:clamp(1.5rem,3.5vw,3rem);letter-spacing:-.06em;margin:0;font-weight:900;line-height:1.1}h1 span{color:#78856b;font-size:.55em;letter-spacing:-.03em}.classification{font-size:.7rem;line-height:1.7;text-align:right;color:#819078}.game-frame{width:100%;max-width:calc((100dvh - 285px)*1.6);margin-inline:auto;position:relative;background:#050806;border:1px solid #58634c;box-shadow:0 0 0 5px #111810,0 20px 70px #000b;overflow:hidden}canvas{display:block;width:100%;aspect-ratio:16/10;height:auto;image-rendering:pixelated;image-rendering:crisp-edges;outline:none;touch-action:none}.scanlines{position:absolute;inset:0;pointer-events:none;z-index:1;opacity:.15;background:repeating-linear-gradient(0deg,#000 0,#000 1px,transparent 1px,transparent 3px)}.game-hud{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;padding:16px 24px;background:linear-gradient(0deg,#050805f5,#0c120bec);border-top:2px solid #364330;gap:25px;pointer-events:none}.game-hud span{font-size:.65rem;color:#829274;letter-spacing:.1em;display:block;margin-bottom:6px}.game-hud strong{font-size:1rem;display:block;color:#c4ccaa}.stamina{width:32%;max-width:260px}.meter{height:9px;border:1px solid #515e42;padding:1px}.meter i{height:100%;width:100%;display:block;background:#93a56d}.overlay{position:absolute;inset:0;background:#050906a3;z-index:2;display:grid;place-items:center;padding:20px;overflow:auto;backdrop-filter:blur(2px)}.overlay-card{width:100%;max-width:510px;text-align:center;padding:28px;background:#0c130fed;border:1px solid #526247;box-shadow:10px 10px 0 #0005}h2{font-size:clamp(2rem,4vw,3.2rem);font-weight:bold;letter-spacing:-.065em;line-height:1;margin:0 0 22px;color:#e4e4cb}h2 em{color:#b8c596;font-style:normal}.overlay-card>p:not(.label){font-size:.85rem;line-height:1.6;color:#bac0aa;margin:0 0 16px}.overlay-card .reward-note{color:#d4d0a8!important}.primary,.secondary{display:block;width:100%;text-align:center;padding:14px 18px;border:1px solid #a3af80;font-size:.9rem;margin-top:10px}.primary{background:#b0bf8c;color:#0c130c;font-weight:bold}.primary:hover{background:#d8dfbe}.secondary{background:transparent;color:#bdc6aa;border-color:#45533b}.small{font-size:.7rem!important;line-height:1.6!important;color:#809175!important;margin:16px 0 0!important}#load-status{font-size:.7rem;color:#879a77;margin:10px 0 0}.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:20px}.toolbar button{font-size:.75rem;border:1px solid #405139;padding:10px 13px;color:#c3cbb2;background:#111b11;min-height:42px}.toolbar button[aria-pressed=true]{border-color:#acbd87;background:#293621}.toolbar>span{margin-left:auto;font-size:.75rem;color:#8e9d7f}.touch-controls{display:none;justify-content:space-between;gap:20px;margin-top:22px}.touch-controls button{min-height:50px;min-width:54px;color:#cbd2b6;background:#162012;border:1px solid #526344;padding:10px;touch-action:none;user-select:none;-webkit-user-select:none}.touch-controls button.active{background:#6a7c4d;color:#fff}.move-pad{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.move-pad button:first-child{grid-column:2}.move-pad button:nth-child(2){grid-column:1}.look-pad{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}footer{display:flex;justify-content:space-between;gap:25px;color:#718468;font-size:.7rem;line-height:1.8;margin-top:22px}footer p{margin:0}kbd{font:inherit;color:#a5b292}.code-label{margin-top:25px}.reward{font-size:clamp(1rem,3vw,1.4rem);padding:16px 10px;border:1px dashed #9ba878;background:#182113;color:#e0e7bd;margin-bottom:15px;user-select:all;overflow-wrap:anywhere}.victory-links{display:flex;justify-content:center;align-items:center;gap:24px;font-size:.75rem;margin-top:20px}.victory-links a{text-decoration:underline;text-underline-offset:4px}.text-button{color:#a6b493;background:none;border:none;text-decoration:underline;padding:8px}body.reduced .scanlines{display:none}
  #briefing{padding:18px 22px}#briefing h2{font-size:2.25rem;margin-bottom:14px}#briefing>p:not(.label){font-size:.78rem;line-height:1.5;margin:0 0 12px}#briefing .small{font-size:.65rem!important;margin-top:12px!important}#briefing .label{margin-bottom:12px}
  @media(pointer:coarse){.touch-controls{display:flex}}@media(max-width:700px){.terminal-shell{padding:0 16px}header{padding:18px 0}.record,header>a span,.classification{display:none}main{padding:25px 0}.titlebar{margin-bottom:18px}.titlebar .label{font-size:.65rem}h1{font-size:1.65rem}.game-hud{padding:10px 12px;gap:10px}.game-hud span{font-size:.55rem}.game-hud strong{font-size:.65rem}.game-hud .stamina{width:25%}.toolbar{gap:6px}.toolbar button{padding:9px 10px;font-size:.7rem}.toolbar>span{width:100%;margin:8px 0 0}.overlay{padding:10px}.overlay-card{padding:18px 15px}.overlay-card p:not(.label){font-size:.75rem;margin-bottom:10px}.overlay-card h2{font-size:2rem;margin-bottom:15px}#briefing h2{font-size:1.8rem}#briefing{padding:16px}.overlay-card .small{font-size:.6rem!important}.overlay-card .primary,.overlay-card .secondary{padding:11px}.overlay-card .label{font-size:.65rem;margin-bottom:8px}.game-frame{max-width:100%;overflow:visible}.overlay{overflow:auto;align-items:start}.game-frame canvas{min-height:350px;object-fit:cover}.overlay-card #load-status{margin-top:8px}footer{display:block}footer p+p{margin-top:10px}.touch-controls{display:flex}.code-label{margin-top:15px}}
  @media(max-height:650px) and (min-width:701px){main{padding-top:20px}.titlebar{margin-bottom:15px}.game-frame{max-width:900px;margin:auto}.overlay-card{padding:15px 25px}.overlay-card>p:not(.label){margin-bottom:10px}.overlay-card h2{font-size:2rem;margin-bottom:12px}.overlay-card .small{margin-top:10px!important}}
</style>
