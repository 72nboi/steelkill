---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, site, url } from '../lib/catalog';
const featured = products.filter(product => product.featured).slice(0, 6);
const edits = site.edits;
---
<Layout title="Feel The Steel">
  <section class="hero" id="top">
    <Photo src={site.hero} alt="SteelKill spiked chainmail styled with gothic lace and bold makeup" class="hero-image" sizes="100vw" eager/>
    <div class="hero-shade"></div>
    <div class="hero-content"><p class="eyebrow">STEELKILL / HANDMADE CHAINMAIL</p><h1>Born of steel.<br/><em>Bound to none.</em></h1><p>Steel. Spikes. Bone.<br/>Armour for your dark side.</p><a class="button button-light" href={url('products/')}>Explore the collection</a></div>
    <span class="hero-caption">CHAINMAIL. BONE. ATTITUDE.</span>
  </section>
  <div class="brand-strip" aria-hidden="true"><span>HANDMADE. HARD TO IGNORE.</span><span>✦</span><span>CHAINMAIL WITH A DARKER SIDE</span><span>✦</span><span>WEAR WHAT YOU ARE.</span></div>
  <section class="section featured" id="collection"><div class="section-heading"><div><p class="eyebrow">THE STEELKILL EDIT</p><h2>Wear your<br/><em>darker side.</em></h2></div><div class="heading-aside"><p>Interlocked rings. Sharp details.<br/>Nothing tame. Nothing delicate.</p><a class="underlined" href={url('products/')}>View all {products.length} pieces</a></div></div><div class="product-grid">{featured.map(product => <ProductCard product={product}/>)}</div></section>
  <section class="category-section"><div class="section-heading section-heading-small"><p class="eyebrow">FIND YOUR ARMOUR</p><h2>Choose your obsession.</h2></div><div class="category-grid">{edits.map(edit => <a class="category-card" href={url(`products/?category=${encodeURIComponent(edit.category)}`)}><Photo src={edit.image} alt={`SteelKill ${edit.title.toLowerCase()}`} sizes="(max-width: 650px) 90vw, 33vw"/><div><p>{edit.subtitle}</p><h3>{edit.title}</h3><span class="underlined">Explore {edit.title.toLowerCase()}</span></div></a>)}</div></section>
  <section class="world section" id="our-world"><div class="world-image"><Photo src={site.editorial} alt="SteelKill chainmail styled as part of an alternative fashion look" sizes="(max-width: 800px) 100vw, 50vw"/></div><div class="world-copy"><p class="eyebrow">WELCOME TO OUR WORLD</p><h2>Cold steel.<br/><em>Dark intent.</em></h2><p class="lead">No softness.<br/>No surrender.</p><p>Interlocked steel. Bared spikes. Real bone. Handmade chainmail with a vicious edge.</p><p>Wear it like armour. Carry it like a curse.</p><a class="underlined" href={site.instagram} target="_blank" rel="noopener noreferrer">Meet us on Instagram</a></div></section>
  <section class="lookbook section"><div class="section-heading"><div><p class="eyebrow">OFF THE DISPLAY. INTO THE WORLD.</p><h2>Made to be <em>worn.</em></h2></div><a class="underlined" href={site.instagram} target="_blank" rel="noopener noreferrer">Follow @steel_kill_</a></div><div class="lookbook-grid">{site.lookbook.map((image, i) => <Photo src={image} alt={`SteelKill jewellery in an alternative fashion look, photograph ${i + 1}`} sizes="(max-width: 650px) 48vw, 25vw"/>)}</div></section>
</Layout>
