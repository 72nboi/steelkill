---
import { photo } from '../lib/catalog';
interface Props { src: string; alt: string; class?: string; sizes?: string; eager?: boolean; }
const { src, alt, sizes = '(max-width: 650px) 100vw, 50vw', eager = false, class: className } = Astro.props;
---
<img src={photo(src)} srcset={`${photo(src, 480)} 480w, ${photo(src, 960)} 960w, ${photo(src, 1600)} 1600w`} sizes={sizes} alt={alt} class={className} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" width="960" height="1200" />
