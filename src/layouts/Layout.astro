---
import '../styles/steelkill.css';
import { site, url } from '../lib/catalog';
interface Props { title: string; description?: string; }
const { title, description = 'Handmade chainmail jewellery. Gothic necklaces, chokers, bracelets and bone pieces by SteelKill.' } = Astro.props;
const path = Astro.url.pathname;
const active = (name: string) => path.includes(`/${name}`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description}/><meta name="theme-color" content="#080808" />
    <meta property="og:title" content={`${title} | SteelKill`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/><title>{title} | SteelKill</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="announcement">HANDMADE CHAINMAIL JEWELLERY <span>FOR THE DARK AT HEART</span></div>
    <header class="site-header">
      <a class="brand" href={url()} aria-label="SteelKill home"><img src={url('images/optimized/steelkill-logo.webp')} width="180" height="105" alt="SteelKill"/></a>
      <nav aria-label="Main navigation"><a href={url('products/')} aria-current={active('products') ? 'page' : undefined}>The collection</a><a href={`${url()}#our-world`}>Our world</a><a href={url('contact/')} aria-current={active('contact') ? 'page' : undefined}>Get in touch</a></nav>
      <a class="header-instagram" href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="SteelKill on Instagram"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg></a>
    </header>
    <main id="main"><slot/></main>
    <section class="footer-callout"><p>Feel The Steel</p><a class="button button-outline" href={url('contact/')}>Talk to SteelKill</a></section>
    <footer class="site-footer"><a class="footer-logo" href={url()} aria-label="SteelKill home"><img src={url('images/optimized/steelkill-logo.webp')} width="240" height="140" alt="SteelKill" loading="lazy"/></a><div><p class="eyebrow">STEEL. BONE. NO MERCY.</p><p>Heavy metal. Dark intentions.</p></div><div class="footer-links"><a href={url('products/')}>The collection</a><a href={url('contact/')}>Contact & care</a><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} SteelKill</span><span>Prices in GBP (£). Shipping confirmed on enquiry.</span><a href="#top" id="back-to-top">Back to top</a></div></footer>
  </body>
</html>
